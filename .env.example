# =============================================================================
# Forkcast — Environment Variables (.env.example)
# =============================================================================
# Copy this file to `.env` (gitignored) and populate GEMINI_API_KEY.
# Default model IDs, reasoning settings, temperatures, timeouts, and retries
# live in `config.yaml` (git-tracked). Any value below is optional and overrides
# `config.yaml` server-side only (never sent to the browser).

# Google AI Studio API key (required for generation, edits, critic, chat, voice, and scripts)
GEMINI_API_KEY=

# Optional overrides (defaults live in config.yaml):
# GEMINI_INCLUDE_THOUGHTS=false
# FORKCAST_MODEL_GENERATOR=gemini-4-hydrogen
# FORKCAST_MODEL_GENERATOR_FALLBACK=gemini-4-argon
# FORKCAST_MODEL_EDITOR=gemini-4-hydrogen
# FORKCAST_MODEL_EDITOR_CORE=gemini-4-neon
# FORKCAST_MODEL_DISAMBIGUATE=gemini-4-hydrogen
# FORKCAST_MODEL_UX_EVAL=gemini-4-carbon
# FORKCAST_MODEL_JUDGE=gemini-4-neon
# FORKCAST_MODEL_ASSISTANT=gemini-3.5-flash-lite
# FORKCAST_MODEL_SIMULATOR=gemini-3.5-flash-lite
# FORKCAST_MODEL_TRANSCRIBE=gemini-3.5-transcribe
