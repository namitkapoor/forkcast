# =============================================================================
# Forkcast Studio — Gemini 4 Series Models & Reasoning Levels (.env.example)
# =============================================================================
# Copy this file to `.env` (gitignored) and populate GEMINI_API_KEY.
# All values are sourced directly by `src/ai/llmConfig.ts` on load.
#
# Gemini 4 Series Tiers:
#   gemini-4-carbon   -> Flagship deep reasoning      (thinking levels: LOW | MEDIUM | HIGH)
#   gemini-4-argon    -> Frontier enterprise reasoning (thinking levels: LOW | MEDIUM | HIGH)
#   gemini-4-neon     -> Balanced high-craft workhorse (thinking levels: LOW | MEDIUM | HIGH | XHIGH)
#   gemini-4-hydrogen -> Fast / high-throughput value  (thinking levels: LOW | MEDIUM | HIGH | XHIGH)

# --- Core Credentials & Global Controls --------------------------------------
GEMINI_API_KEY=

# Optional override: "false" forces Live Gemini 4, "true" forces Demo/Mock mode.
# Leave unset to automatically use Live Gemini 4 whenever GEMINI_API_KEY is set.
# GEMINI_USE_MOCK_FALLBACK=false

# Set to "true" to request thought summaries alongside structured JSON responses.
GEMINI_INCLUDE_THOUGHTS=false

# =============================================================================
# Per-Call Gemini 4 Routing & Explicit Reasoning Levels
# =============================================================================

# 1. Intent & Ambiguity Check (LOW STAKES — fast pre-flight disambiguation micro-UI)
GEMINI_DISAMBIGUATE_MODEL=gemini-4-hydrogen
GEMINI_DISAMBIGUATE_THINKING_LEVEL=LOW

# 2. User Flow Architect (HIGH STAKES — journey graph, Focus Zones & progressive skeletons)
GEMINI_FLOW_ARCHITECT_MODEL=gemini-4-carbon
GEMINI_FLOW_ARCHITECT_THINKING_LEVEL=HIGH

# 3. Core UX Variant Generator (HIGH STAKES — divergent UI options for Core Focus flows)
GEMINI_VARIANT_CORE_MODEL=gemini-4-neon
GEMINI_VARIANT_CORE_THINKING_LEVEL=HIGH

# 4. Standard Variant Generator (MEDIUM STAKES — balanced alternatives for standard flows)
GEMINI_VARIANT_STANDARD_MODEL=gemini-4-neon
GEMINI_VARIANT_STANDARD_THINKING_LEVEL=MEDIUM

# 5. Supporting / Exploit-Locked Variant Generator (LOW STAKES — fast cheap expansion)
GEMINI_VARIANT_SUPPORTING_MODEL=gemini-4-hydrogen
GEMINI_VARIANT_SUPPORTING_THINKING_LEVEL=LOW

# 6. Core Point & Paint / @Screen Refinement (HIGH STAKES — multimodal mask + feedback)
GEMINI_REFINE_CORE_MODEL=gemini-4-neon
GEMINI_REFINE_CORE_THINKING_LEVEL=HIGH

# 7. Small / Localized Refinement (LOW STAKES — copy/style tweaks on standard/locked screens)
GEMINI_REFINE_SMALL_MODEL=gemini-4-hydrogen
GEMINI_REFINE_SMALL_THINKING_LEVEL=LOW

# 8. Core Multimodal UX Evaluator (HIGH STAKES — deep usability & edge continuity critique)
GEMINI_UX_EVAL_CORE_MODEL=gemini-4-carbon
GEMINI_UX_EVAL_CORE_THINKING_LEVEL=HIGH

# 9. Light UX Heuristic Check (LOW STAKES — quick structural check on secondary screens)
GEMINI_UX_EVAL_LIGHT_MODEL=gemini-4-hydrogen
GEMINI_UX_EVAL_LIGHT_THINKING_LEVEL=LOW

# 10. Simulated Persona Traversals (MEDIUM STAKES — synthetic user dwell/backtrack runs)
GEMINI_PERSONA_SIM_MODEL=gemini-4-hydrogen
GEMINI_PERSONA_SIM_THINKING_LEVEL=MEDIUM

# 11. Streaming Voice Audio Transcription (LOW STAKES — dedicated Gemini audio transcriber or gemini-4-hydrogen)
GEMINI_VOICE_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_VOICE_TRANSCRIBE_THINKING_LEVEL=LOW
